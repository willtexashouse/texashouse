# Sanity — fill these in after creating a Sanity project at https://sanity.io/manage
# See docs/setup.md for the full walkthrough.

# Project ID from your Sanity project (safe to expose to the browser)
# Texas House project: naolvj96 (already set as the default in config)
PUBLIC_SANITY_PROJECT_ID="naolvj96"

# Dataset name (usually "production")
PUBLIC_SANITY_DATASET="production"

# Sanity API version (date-pinned; leave as-is unless you know you need a newer one)
PUBLIC_SANITY_API_VERSION="2024-01-01"

# Read token — ONLY needed for private datasets or to read drafts/previews.
# Keep this server-side (no PUBLIC_ prefix). Leave blank for a public dataset.
SANITY_API_READ_TOKEN=""

# Higgsfield API — create a key at https://cloud.higgsfield.ai, then copy both values into .env (gitignored).
HF_API_KEY_ID=
HF_API_KEY_SECRET=
