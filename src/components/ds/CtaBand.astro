---
import Button from './Button.astro';
/*
  The closing CTA band. Appears on every page — Become a Partner is the primary
  conversion (wireframe-brief.md).
*/
interface Props { heading?: string; sub?: string }
const {
  heading = 'Partner with Texas House',
  sub = 'Named placement. Programming voice. The introductions you came for.',
} = Astro.props;
---

<section class="txh-cta" data-section="Partner">
  <hr class="txh-rule-dashed" />
  <div class="txh-cta__inner">
    <div>
      <h2 class="txh-display-sm txh-cta__heading">{heading}</h2>
      <p class="txh-cta__sub">{sub}</p>
    </div>
    <Button href="/partnerships" fill="clay">Become a Partner</Button>
  </div>
</section>

<style>
  .txh-cta { padding: 0 var(--page-gutter); }
  .txh-cta__inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-6); flex-wrap: wrap;
    padding: var(--space-8) 0;
  }
  .txh-cta__heading { font-size: clamp(28px, 3.6vw, 46px); }
  /* Body copy — the band now states the offer rather than carrying a signature. */
  .txh-cta__sub {
    font-family: var(--font-body-web, inherit);
    font-size: 16px;
    letter-spacing: 0;
    line-height: 1.5;
    color: var(--txh-fg-2);
    max-width: 44ch;
    margin-top: var(--space-3);
  }
</style>
