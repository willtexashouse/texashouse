---
/*
  Bluebonnet field for the footer horizon band (VISUAL_LANGUAGE.md §5.4,
  option 1: parallax layers in code). Three transparent plates, back to front,
  anchored to the bottom of the band. Replaces the ported WebGL dither.

  The plates live in public/brand/bluebonnets/: the bottom 55% of 21:9
  Higgsfield renders made from the dusk bluebonnet concept, each carrying only
  its own layer on the gun metal ground and knocked out to alpha (see
  brand/renders.md). 1600px wide, PNG-8 with alpha. Replacing a plate needs no
  code change as long as its content stays bottom-anchored.

  Motion is vanilla: an IntersectionObserver arms a rAF loop only while the band
  is on screen, layers rise on first entry, then parallax with scroll and sway
  with a wind function that gusts on scroll velocity. Transforms only — no
  layout, no libraries, no React. prefers-reduced-motion turns all of it off and
  leaves the layers at their resting positions.
*/

// Three plates ship. A fourth, near.png (medium clusters), is cut and logged
// but left out: with it in, the stack is a wall of flowers and the ridge and
// the depth between layers disappear. Add it back here and in SPEC below if
// the field ever needs to be denser.
const LAYERS = [
  { key: 'far', src: '/brand/bluebonnets/far.png' },
  { key: 'mid', src: '/brand/bluebonnets/mid.png' },
  { key: 'front', src: '/brand/bluebonnets/front.png' },
] as const;
---

<div class="txh-bluebonnets" data-bluebonnets aria-hidden="true">
  {LAYERS.map((l) => (
    <img
      class="txh-bluebonnets__layer"
      data-layer={l.key}
      src={l.src}
      alt=""
      loading="lazy"
      decoding="async"
    />
  ))}
</div>

<style>
  /* Sits inside .txh-footer__horizon, above the drape and its grain, below the
     wordmark (z-index 1). No z-index of its own — DOM order does the work. */
  .txh-bluebonnets {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* Wider than the band on both sides so horizontal sway never exposes an edge.
     Bottom-anchored: the flowers stand on the band's bottom edge and the band
     crops whatever runs past the top. At 1440px the plates scale to ~375px tall,
     so the 360px band shows almost the whole cut. */
  .txh-bluebonnets__layer {
    position: absolute;
    left: -6%;
    bottom: 0;
    width: 112%;
    /* Tailwind's preflight caps images at max-width:100%, which would clip the
       6% of overhang the sway needs. Opt this one out. */
    max-width: none;
    height: auto;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
    transform-origin: 50% 100%; /* bend from the base, not the middle */
    will-change: transform;
  }

  /* The mid band sits a little below the band's floor so the far ridge keeps
     its headroom and the field reads as rolling away, not stacked. */
  .txh-bluebonnets__layer[data-layer='mid'] { bottom: -2.6vw; }

  @media (prefers-reduced-motion: reduce) {
    .txh-bluebonnets__layer {
      will-change: auto;
      transform: none;
    }
  }
</style>

<script>
  (() => {
    const root = document.querySelector<HTMLElement>('[data-bluebonnets]');
    if (!root) return;

    const band = root.closest<HTMLElement>('.txh-footer__horizon') ?? root;

    // Back to front. depth = parallax travel, amp/freq = wind, skew = bend.
    const SPEC = [
      { key: 'far', rise: 10, depth: 6, amp: 2, freq: 0.25, skew: 0 },
      { key: 'mid', rise: 24, depth: 16, amp: 4, freq: 0.32, skew: 0.4 },
      { key: 'front', rise: 54, depth: 40, amp: 11, freq: 0.5, skew: 1.4 },
    ] as const;

    const RISE_MS = 900;
    const STAGGER_MS = 60; // front leads, far trails
    const GUST_MAX = 1.5; // wind multiplier tops out at 1 + 1.5 = 2.5x
    const GUST_TAU = 400; // exp decay -> ~5% left after 1.2s
    const GUST_FULL = 55; // px/frame of scroll that counts as a full gust
    const PHASE_GAIN = 0.0045; // radians of phase push per px scrolled

    type Layer = (typeof SPEC)[number] & { el: HTMLElement; delay: number };

    const layers: Layer[] = [];
    SPEC.forEach((spec, i) => {
      const el = root.querySelector<HTMLElement>(`[data-layer="${spec.key}"]`);
      if (!el) return;
      // front-to-back stagger: front (last in SPEC) starts first.
      layers.push({ ...spec, el, delay: (SPEC.length - 1 - i) * STAGGER_MS });
    });
    if (!layers.length) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reduced.matches) return; // static at rest: no rise, parallax, sway or gusts

    /* cubic-bezier(.22, 1, .36, 1) — the rise easing, solved by Newton. */
    const bezier = (() => {
      const x1 = 0.22;
      const y1 = 1;
      const x2 = 0.36;
      const y2 = 1;
      const cx = 3 * x1;
      const bx = 3 * (x2 - x1) - cx;
      const ax = 1 - cx - bx;
      const cy = 3 * y1;
      const by = 3 * (y2 - y1) - cy;
      const ay = 1 - cy - by;
      const sampleX = (t: number) => ((ax * t + bx) * t + cx) * t;
      const slopeX = (t: number) => (3 * ax * t + 2 * bx) * t + cx;
      return (x: number) => {
        let t = x;
        for (let i = 0; i < 5; i += 1) {
          const d = slopeX(t);
          if (d === 0) break;
          t -= (sampleX(t) - x) / d;
        }
        t = Math.min(1, Math.max(0, t));
        return ((ay * t + by) * t + cy) * t;
      };
    })();

    let raf = 0;
    let running = false;
    let riseStart = 0; // 0 until the band is first seen
    let last = 0;
    let phase = 0; // wind phase, pushed around by scroll direction
    let vel = 0; // smoothed scroll velocity, px per frame
    let gust = 0; // 0..1
    let lastScrollY = window.scrollY;

    const clamp01 = (n: number) => (n < 0 ? 0 : n > 1 ? 1 : n);

    const frame = (now: number) => {
      if (!running) return;
      const dt = last ? Math.min(64, now - last) : 16;
      last = now;

      // --- scroll velocity, smoothed, then folded into a decaying gust ------
      const y = window.scrollY;
      const raw = y - lastScrollY;
      lastScrollY = y;
      vel = vel * 0.8 + raw * 0.2;
      const target = clamp01(Math.abs(vel) / GUST_FULL);
      gust = Math.max(target, gust * Math.exp(-dt / GUST_TAU));
      const wind = 1 + gust * GUST_MAX;

      // Scrolling down pushes the sway phase forward, up pulls it back.
      phase += vel * PHASE_GAIN;

      // --- band progress through the viewport, 0 entering -> 1 leaving -----
      const rect = band.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight;
      const progress = clamp01((vh - rect.top) / (vh + rect.height));

      const t = now / 1000;
      const riseT = riseStart ? now - riseStart : 0;

      for (const l of layers) {
        // rise: per-layer offset easing to 0 over 900ms after its stagger
        const p = clamp01((riseT - l.delay) / RISE_MS);
        const riseY = l.rise * (1 - bezier(p));

        // parallax: near layers travel further than far ones
        const parY = (0.5 - progress) * l.depth;

        // wind: primary sine plus a faster, quieter one so it is not metronomic
        const w = 2 * Math.PI * l.freq * t + phase;
        const swayUnit = Math.sin(w) + 0.3 * Math.sin(2.3 * w + 1.7);
        const x = l.amp * wind * swayUnit;
        const skew = l.skew ? l.skew * wind * swayUnit : 0;

        l.el.style.transform =
          `translate3d(${x.toFixed(2)}px, ${(parY + riseY).toFixed(2)}px, 0)` +
          (skew ? ` skewX(${skew.toFixed(3)}deg)` : '');
      }

      raf = requestAnimationFrame(frame);
    };

    const start = () => {
      if (running) return;
      running = true;
      if (!riseStart) riseStart = performance.now();
      last = 0;
      lastScrollY = window.scrollY;
      raf = requestAnimationFrame(frame);
    };

    const stop = () => {
      running = false;
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      vel = 0;
      gust = 0;
    };

    let io: IntersectionObserver | null = null;
    if ('IntersectionObserver' in window) {
      io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) start();
            else stop();
          }
        },
        { rootMargin: '80px 0px' },
      );
      io.observe(band);
    } else {
      start();
    }

    const onReduced = () => {
      if (!reduced.matches) return;
      stop();
      for (const l of layers) l.el.style.transform = '';
    };
    reduced.addEventListener?.('change', onReduced);

    // No view transitions in this project (no ClientRouter / astro:before-swap),
    // so a page navigation is a full document swap and tears this down for us.
    window.addEventListener('pagehide', () => {
      stop();
      io?.disconnect();
    });
  })();
</script>
