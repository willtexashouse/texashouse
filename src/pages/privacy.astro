---
import BaseLayout from '../layouts/BaseLayout.astro';
/*
  Privacy Policy — scaffold. Real copy exists on the live Webflow site; see
  migration/webflow-pages/raw/privacy-policy.html for the current text.
*/
---
<BaseLayout title="Privacy Policy — Texas House">
  <main class="txh-legal" data-section="Privacy Policy">
    <div class="txh-sechead">
      <div>
        <div class="txh-sechead__num">§08<em>Legal</em></div>
        <h1 class="txh-display txh-sechead__title">Privacy Policy</h1>
      </div>
    </div>
    <div class="txh-legal__body">
      <p>This page is being rebuilt. The current Privacy Policy is available on the existing site.</p>
    </div>
  </main>
</BaseLayout>
<style>
  .txh-legal { padding: var(--space-8) var(--page-gutter) var(--space-9); }
  .txh-legal__body { max-width: 68ch; margin-top: var(--space-7); font-size: var(--fs-body); line-height: var(--lh-body); color: var(--txh-fg-2); }
</style>
