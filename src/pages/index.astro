---
import BaseLayout from '../layouts/BaseLayout.astro';
import { safeFetch } from '../lib/sanity/safeFetch';
import {
  HOME_PAGE_QUERY,
  PAST_EVENTS_QUERY,
  FEATURED_ARTICLE_QUERY,
  RECENT_ARTICLES_QUERY,
} from '../lib/sanity/queries';

// Data wiring is in place; the branded markup arrives via the Claude Design import.
const home = await safeFetch<any>(HOME_PAGE_QUERY, {}, null);
const pastEvents = await safeFetch<any[]>(PAST_EVENTS_QUERY, {}, []);
const featured = await safeFetch<any>(FEATURED_ARTICLE_QUERY, {}, null);
const recent = await safeFetch<any[]>(RECENT_ARTICLES_QUERY, { limit: 3 }, []);
---

<BaseLayout title="Texas House">
  <main class="mx-auto max-w-3xl px-6 py-24">
    <p class="text-sm uppercase tracking-widest text-[var(--color-brand-accent)]">
      Foundation scaffold
    </p>
    <h1 class="mt-4 font-[var(--font-display)] text-4xl font-semibold">Texas House</h1>
    <p class="mt-4 text-lg">
      Building the network of ascending leaders in Texas. This is the Astro +
      Sanity foundation — branded design will be imported from Claude Design and
      slotted into these sections.
    </p>

    <!--
      Section scaffold (see docs/information-architecture.md):
      Hero · About (marquee, postcards, what we do) · Upcoming Events ·
      Past Events · Recent Articles · Footer
      Data fetched above is ready to feed the imported components.
    -->
    <ul class="mt-10 space-y-1 text-sm text-neutral-600">
      <li>Home content: {home ? 'loaded' : 'not configured yet'}</li>
      <li>Past events: {pastEvents.length}</li>
      <li>Featured article: {featured ? 'yes' : 'none'}</li>
      <li>Recent articles: {recent.length}</li>
    </ul>
  </main>
</BaseLayout>
