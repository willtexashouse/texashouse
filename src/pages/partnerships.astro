---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ds/Button.astro';
import { safeFetch } from '../lib/sanity/safeFetch';
import { SPONSORS_QUERY, PARTNERSHIPS_PAGE_QUERY } from '../lib/sanity/queries';
import { urlFor } from '../lib/sanity/image';

/*
  "Become a Partner" — the conversion page. Every CTA on the site routes here,
  so the page opens on the ask (header + inquiry form) rather than working up
  to it, and it ends on its own closing CTA (BaseLayout cta={false}).

  ─────────────────────────────────────────────────────────────────────────────
  TODO — FORM DESTINATION UNDECIDED (email vs CRM).
  See docs/README.md → "Pending input" → "Contact-form destination (email / CRM)".
  The form below is markup only: method="post", NO action, NO handler, NO
  client script. Do not wire a backend here until Will picks the destination.
  ─────────────────────────────────────────────────────────────────────────────
*/

// ── Data ────────────────────────────────────────────────────────────────────

// Logos for "Brands we've worked with". SPONSORS_QUERY is the full sponsor
// list; a sponsor with no logo has nothing to show, so it is filtered out.
const sponsors = await safeFetch<any[]>(SPONSORS_QUERY, {}, []);
const withLogos = sponsors.filter((s) => s?.logo);
const LOGO_CAP = 24;
const shownLogos = withLogos.slice(0, LOGO_CAP);
const moreLogos = Math.max(0, withLogos.length - shownLogos.length);

// There is no exported FAQ query — partnerships is the only category the
// schema defines (sanity/schemaTypes/documents/faq.ts), so it lives here.
const FAQ_QUERY = `*[_type=="faq" && category=="partnerships"] | order(order asc){question, answer}`;
const faqDocs = await safeFetch<any[]>(FAQ_QUERY, {}, []);

// The partnerships singleton carries its own curated faqs[] reference list.
// Order of preference: standalone FAQ docs → the singleton's list → drafts.
const partnershipsPage = await safeFetch<any>(PARTNERSHIPS_PAGE_QUERY, {}, null);

/* `faq.answer` is portable text (an array of blocks), not a string — flatten it
   to plain paragraphs so the accordion can render it without a PortableText
   component. Also passes strings straight through, in case an editor's field
   type changes later. */
const toText = (v: any): string[] => {
  if (typeof v === 'string') return v.trim() ? [v] : [];
  if (!Array.isArray(v)) return [];
  return v
    .map((b: any) => (b?.children ?? []).map((c: any) => c?.text ?? '').join(''))
    .map((s: string) => s.trim())
    .filter(Boolean);
};

// draft copy — confirm with Will
const FAQ_FALLBACK = [
  {
    question: 'How do sponsorships work?',
    answer: [
      'You pick the activation, we scope the placement around what you actually want out of the room. Programming, guest allocation, and recognition are set in the proposal, then we build the weekend around it.',
    ],
  },
  {
    question: 'How much does it cost to sponsor?',
    answer: [
      'It depends on the activation and the tier — a headline placement at a flagship week and a supporting placement at a single dinner are not the same number. The first conversation covers budget openly, so nobody spends a month on a proposal that was never going to fit.',
    ],
  },
  {
    question: 'What are curated connections?',
    answer: [
      'We ask who you are trying to meet, then we place those meetings on purpose — seating, dinners, and hallway introductions planned before the doors open. It is the difference between attending an event and leaving it with a list of people who already know your name.',
    ],
  },
  {
    question: 'How do in-kind sponsorships work?',
    answer: [
      'You put product, venue, spirits, or services into the room instead of writing a cheque, and we treat it as a partnership rather than a donation. In-kind partners get tier recognition, guest allocation, and the same recap the cash partners get.',
    ],
  },
  {
    question: 'What does preferred partner status include?',
    answer: [
      'A standing presence across the year rather than one weekend — first look at programming as it is planned, and access to our superconnectors between activations. Preferred partners are the ones we call before we announce anything.',
    ],
  },
  {
    question: 'When should we start planning an activation?',
    answer: [
      'Eight to twelve weeks out is comfortable and gives us room to build programming around you. Closer than that is possible, it just gets smaller — the good placements go early.',
    ],
  },
];

const faqSource =
  faqDocs.length > 0 ? faqDocs
  : (partnershipsPage?.faqs?.length ? partnershipsPage.faqs : []);

const faqs = faqSource.length > 0
  ? faqSource
      .map((f: any) => ({ question: f?.question, answer: toText(f?.answer) }))
      .filter((f: any) => f.question)
  : FAQ_FALLBACK;

// ── Static content ──────────────────────────────────────────────────────────

const INTERESTS = ['Sponsorship', 'In-Kind', 'Preferred Partner', 'Membership', 'Other'];

const JOURNEY = [
  {
    n: '01',
    name: 'First conversation',
    body: 'We start with what you want out of Texas, and whether we are the right room for it. If we are not, we will say so and point you somewhere better.',
    meta: 'Week 0 · fit call',
  },
  {
    n: '02',
    name: 'Shape the activation',
    body: 'Programming, placement, and the people who should be there, drawn up as a scoped proposal. You see the guest picture before you commit to it.',
    meta: 'Weeks 1–4 · proposal',
  },
  {
    n: '03',
    name: 'Activation weekend',
    body: 'Your brand sits inside the moment, not next to it. Our team runs the floor, works the introductions, and keeps the room moving.',
    meta: 'Event week · on the ground',
  },
  {
    n: '04',
    name: 'Follow-through',
    body: 'Introductions logged, next steps booked, recap delivered while the weekend is still warm. The partnership is measured by what happens after everyone flies home.',
    meta: 'Week after · recap + intros',
  },
];

const WHAT_WE_DO = [
  {
    n: '01',
    title: 'Activations',
    lines: [
      'We build the room — programming, venue, and production around a moment the world is already looking at Texas.',
      'Your brand lives inside the event rather than on a banner beside it.',
    ],
  },
  {
    n: '02',
    title: 'Superconnectors',
    lines: [
      'Texans who know everybody worth knowing, working the room on purpose rather than by luck.',
      'Introductions happen because somebody decided they should happen.',
    ],
  },
  {
    n: '03',
    title: 'Curated Connections',
    lines: [
      'We ask who you need to meet, then place the meeting before the doors open.',
      'Seating, dinners, and hallway conversations are all assignments, not accidents.',
    ],
  },
];

// draft copy — confirm with Will
const TIERS = [
  {
    tier: 'Sponsorship',
    desc: 'Cash partnership on a named activation, scoped to the weekend and the room you want.',
    includes: [
      'Named placement on a banner programme',
      'Speaking placement where it fits the agenda',
      'Guest allocation for your team and your invites',
      'Recap and media rights after the activation',
    ],
    who: 'For brands with a Texas moment to make',
  },
  {
    tier: 'In-Kind',
    desc: 'Product, venue, or service in the room, treated as a partnership rather than a donation.',
    includes: [
      'Product or venue placed inside the activation',
      'Tier recognition on partner walls',
      'Guest allocation at the activation',
      'Recap after the weekend',
    ],
    who: 'For makers, venues, and hospitality partners',
  },
  {
    tier: 'Preferred Partner',
    desc: 'A standing seat across the year instead of a single weekend on the calendar.',
    includes: [
      'Standing presence across every activation',
      'First look at programming as it is planned',
      'Superconnector access between events',
      'Year-round introductions on request',
    ],
    who: 'For partners building in Texas for the long haul',
  },
];
---

<BaseLayout
  title="Become a Partner — Texas House"
  description="Partner with Texas House — sponsorship, in-kind, and preferred partnerships across our activations."
  cta={false}
>
  <main class="txh-page">

    <!-- ═══ 01 · Header + inquiry form ═══════════════════════════════════ -->
    <section data-section="Partner" id="contact">
      <div class="p-split">

        <div class="p-intro">
          <div class="txh-sechead__num">§01<em>Partner with us</em></div>
          <h1 class="txh-display txh-sechead__title p-h1">Become a Partner</h1>

          <div class="p-value">
            <p class="p-value__lead">The network of ascending leaders in Texas — the people about to run it. Partners fund the platform and get in the room first.</p>
            <p>Named placement at the activations the world already attends: SXSW, Race Weekend, SXSW London.</p>
            <p>A voice in the programming, and the introductions you came for.</p>
          </div>
        </div>

        <div class="p-formwrap">
          <span class="txh-tick txh-tick--tl"></span>
          <span class="txh-tick txh-tick--br"></span>

          <!--
            ════════════════════════════════════════════════════════════════
            TODO — FORM DESTINATION UNDECIDED (email vs CRM).
            docs/README.md → "Pending input" → contact-form destination.
            Markup only: no action, no handler, no JS. Do not wire a backend
            until the destination is chosen.
            ════════════════════════════════════════════════════════════════
          -->
          <form class="p-form" method="post">
            <div class="p-form__row">
              <div class="p-field">
                <label class="p-label" for="p-name">Name</label>
                <input class="p-input" type="text" id="p-name" name="name" autocomplete="name" />
              </div>
              <div class="p-field">
                <label class="p-label" for="p-email">Email</label>
                <input class="p-input" type="email" id="p-email" name="email" autocomplete="email" />
              </div>
            </div>

            <div class="p-field">
              <label class="p-label" for="p-org">Organization</label>
              <input class="p-input" type="text" id="p-org" name="organization" autocomplete="organization" />
            </div>

            <div class="p-field">
              <label class="p-label" for="p-role">Role</label>
              <input class="p-input" type="text" id="p-role" name="role" autocomplete="organization-title" />
            </div>

            <div class="p-field">
              <label class="p-label" for="p-interest">Partnership interest</label>
              <select class="p-input p-select" id="p-interest" name="interest">
                {INTERESTS.map((i) => <option value={i}>{i}</option>)}
              </select>
            </div>

            <div class="p-field">
              <label class="p-label" for="p-message">Message</label>
              <textarea class="p-input p-textarea" id="p-message" name="message" rows="4"></textarea>
            </div>

            <div class="p-submit">
              <Button fill="clay">Start the conversation</Button>
            </div>
          </form>
        </div>

      </div>
    </section>

    <!-- ═══ 02 · Brands we've worked with ════════════════════════════════ -->
    {shownLogos.length > 0 && (
      <section data-section="Brands" class="p-sec">
        <div class="txh-sechead">
          <div>
            <div class="txh-sechead__num">§02<em>In good company</em></div>
            <h2 class="txh-display-sm txh-sechead__title p-h2">Brands we've worked with</h2>
          </div>
          <a class="txh-sechead__link" href="/events">See the activations</a>
        </div>

        <div class="p-logos">
          {shownLogos.map((s: any) => (
            <div class="p-logo" title={s.name}>
              <img src={urlFor(s.logo).width(300).url()} alt={s.name} loading="lazy" />
            </div>
          ))}
        </div>

        {moreLogos > 0 && (
          <p class="txh-mono p-logos__more">+ {moreLogos} more across four activations</p>
        )}
      </section>
    )}

    <!-- ═══ 03 · Working with Texas House ════════════════════════════════ -->
    <section data-section="Journey" class="p-sec">
      <div class="txh-sechead">
        <div>
          <div class="txh-sechead__num">§03<em>How it works</em></div>
          <h2 class="txh-display-sm txh-sechead__title p-h2">Working with Texas House</h2>
        </div>
      </div>

      <div class="p-journey">
        {JOURNEY.map((step) => (
          <div class="p-step">
            <div class="p-step__num">{step.n}</div>
            <div>
              <div class="p-step__name">{step.name}</div>
              <p class="p-step__body">{step.body}</p>
            </div>
            <div class="txh-mono p-step__meta">{step.meta}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══ 04 · What we do ══════════════════════════════════════════════ -->
    <section data-section="What we do" class="p-sec">
      <div class="p-cols">
        {WHAT_WE_DO.map((c) => (
          <div class="p-col">
            <div class="txh-mono p-col__num">{c.n}</div>
            <div class="p-col__title">{c.title}</div>
            {c.lines.map((l) => <p class="p-col__line">{l}</p>)}
          </div>
        ))}
      </div>
    </section>

    <!-- ═══ 05 · Partnership tiers ═══════════════════════════════════════ -->
    <section data-section="Tiers" class="p-sec">
      <div class="txh-sechead">
        <div>
          <div class="txh-sechead__num">§04<em>Ways in</em></div>
          <h2 class="txh-display-sm txh-sechead__title p-h2">Partnership tiers</h2>
        </div>
      </div>

      <!-- draft copy — confirm with Will -->
      <div class="p-tiers">
        {TIERS.map((t) => (
          <div class="p-tier">
            <span class="txh-tick txh-tick--tl"></span>
            <span class="txh-tick txh-tick--br"></span>

            <span class="txh-chip">{t.tier}</span>
            <p class="p-tier__desc">{t.desc}</p>

            <ul class="p-tier__list">
              {t.includes.map((i) => <li>{i}</li>)}
            </ul>

            <p class="txh-mono p-tier__who">{t.who}</p>

            <div class="p-tier__cta">
              <Button fill="ghost" href="#contact">Start here</Button>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══ 06 · FAQ ═════════════════════════════════════════════════════ -->
    <section data-section="FAQ" class="p-sec">
      <div class="txh-sechead">
        <div>
          <div class="txh-sechead__num">§05<em>Questions</em></div>
          <h2 class="txh-display-sm txh-sechead__title p-h2">FAQ</h2>
        </div>
      </div>

      <!-- draft copy — confirm with Will (used only when Sanity has no FAQ docs) -->
      <div class="p-faq">
        {faqs.map((f: any) => (
          <details class="p-faq__item">
            <summary class="p-faq__q">
              <span>{f.question}</span>
              <span class="p-faq__ind" aria-hidden="true"></span>
            </summary>
            <div class="p-faq__a">
              {f.answer.map((para: string) => <p>{para}</p>)}
            </div>
          </details>
        ))}
      </div>

      <div class="p-close">
        <div class="p-close__text">Have a question we haven't covered?</div>
        <Button fill="clay" href="#contact">Ask it here</Button>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  /* Full-width page, same gutters as the newsroom. */
  .txh-page { padding: var(--space-8) var(--page-gutter) var(--space-9); }
  .p-sec { margin-top: var(--space-9); }

  /* ── 01 · Header + form ─────────────────────────────────────────────── */
  .p-split {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }
  /* Long title — the sechead default (clamp 38–80px) sets "BECOME A PARTNER"
     wider than the column, so this page runs its own ceiling. */
  .p-h1 { font-size: clamp(34px, 4.6vw, 68px); }
  .p-h2 { font-size: clamp(26px, 3.2vw, 44px); }

  .p-value { margin-top: var(--space-6); max-width: 44ch; }
  .p-value p {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body);
    color: var(--txh-fg-2);
    margin-top: var(--space-3);
  }
  /* Inherits size/leading from .p-value p; needs the extra specificity to win
     the colour cascade against it. */
  .p-value p.p-value__lead {
    color: var(--txh-fg-1);
    font-weight: 600;
  }

  .p-formwrap {
    position: relative;
    border: 1px solid var(--txh-rule);
    padding: var(--space-6);
  }
  .p-form { display: grid; gap: var(--space-4); }
  .p-form__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .p-field { display: flex; flex-direction: column; }

  .p-label {
    font-family: var(--font-eyebrow);
    font-size: 11px;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--txh-fg-4);
    margin-bottom: var(--space-2);
  }
  .p-input {
    width: 100%;
    background: var(--txh-bg-input);
    border: 1px solid var(--txh-border-input);
    border-radius: var(--radius-1);
    color: var(--txh-fg-1);
    padding: 12px 14px;
    font-family: var(--font-body-web);
    font-size: 15px;
    line-height: 1.4;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .p-input:focus-visible { outline: none; border-color: var(--txh-clay-bright); }
  .p-input::placeholder { color: var(--txh-fg-4); }
  .p-textarea { resize: vertical; min-height: 96px; }

  /* Native select arrow is a platform control we cannot recolour, so it is
     replaced with our own chevron. */
  .p-select {
    appearance: none;
    -webkit-appearance: none;
    padding-right: 34px;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8' fill='none'><path d='M1 1.75 6 6.25 11 1.75' stroke='%23999999' stroke-width='1.4' stroke-linecap='square'/></svg>");
    background-repeat: no-repeat;
    background-position: right 12px center;
  }
  .p-select option { background: var(--txh-bg-input); color: var(--txh-fg-1); }

  .p-submit { margin-top: var(--space-2); }

  @media (max-width: 900px) {
    .p-split { grid-template-columns: minmax(0, 1fr); gap: var(--space-7); }
  }
  @media (max-width: 520px) {
    .p-form__row { grid-template-columns: minmax(0, 1fr); }
  }

  /* ── 02 · Brands ────────────────────────────────────────────────────── */
  .p-logos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-6);
  }
  .p-logo {
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--txh-rule);
    border-radius: var(--radius-1);
    padding: var(--space-3);
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .p-logo img {
    max-height: 32px;
    max-width: 78%;
    width: auto;
    height: auto;
    object-fit: contain;
    /* Logos arrive in every brand colour going. Grayscale keeps the wall on
       palette; hover returns the real mark. */
    filter: grayscale(1) brightness(1.6);
    opacity: 0.65;
    transition: opacity var(--dur-base) var(--ease-out), filter var(--dur-base) var(--ease-out);
  }
  .p-logo:hover { border-color: var(--txh-rule-strong); }
  .p-logo:hover img { opacity: 1; }
  .p-logos__more { margin-top: var(--space-5); color: var(--txh-fg-4); }

  /* ── 03 · Journey ───────────────────────────────────────────────────── */
  /* Same left-rule row as the event schedule: number gutter, body column,
     right-aligned mono meta. */
  .p-journey { margin-top: var(--space-5); }
  .p-step {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr) 220px;
    gap: var(--space-5);
    align-items: start;
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--txh-rule);
  }
  .p-step__num {
    font-family: var(--font-display);
    letter-spacing: var(--ls-dreamboat-sm);
    font-size: clamp(40px, 5vw, 64px);
    line-height: 0.9;
    color: var(--txh-decor);
  }
  .p-step__name {
    font-family: var(--font-body-web);
    font-weight: 700;
    font-size: var(--fs-h3);
    line-height: 1.15;
    color: var(--txh-fg-1);
  }
  .p-step__body {
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--txh-fg-3);
    margin-top: var(--space-3);
    max-width: 62ch;
  }
  .p-step__meta {
    color: var(--txh-fg-4);
    text-transform: uppercase;
    text-align: right;
  }
  @media (max-width: 820px) {
    .p-step { grid-template-columns: minmax(0, 1fr); gap: var(--space-3); }
    .p-step__meta { text-align: left; }
  }

  /* ── 04 · What we do ────────────────────────────────────────────────── */
  .p-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }
  .p-col { border-top: 1px solid var(--txh-rule); padding-top: var(--space-4); }
  .p-col__num { color: var(--txh-fg-4); }
  .p-col__title {
    font-family: var(--font-body-web);
    font-weight: 700;
    font-size: var(--fs-h4);
    line-height: 1.2;
    color: var(--txh-fg-1);
    margin-top: var(--space-3);
  }
  .p-col__line {
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--txh-fg-3);
    margin-top: var(--space-3);
  }
  @media (max-width: 860px) {
    .p-cols { grid-template-columns: minmax(0, 1fr); gap: var(--space-5); }
  }

  /* ── 05 · Tiers ─────────────────────────────────────────────────────── */
  .p-tiers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-6);
  }
  .p-tier {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--txh-rule);
    padding: var(--space-6);
  }
  .p-tier .txh-chip { align-self: flex-start; }
  .p-tier__desc {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--txh-fg-2);
    margin-top: var(--space-4);
  }
  .p-tier__list { list-style: none; margin: var(--space-5) 0 0; padding: 0; }
  .p-tier__list li {
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--txh-fg-3);
    border-top: 1px solid var(--txh-rule);
    padding: var(--space-2) 0;
  }
  .p-tier__who {
    color: var(--txh-fg-4);
    margin-top: var(--space-5);
  }
  .p-tier__cta { margin-top: var(--space-5); padding-top: var(--space-2); }

  /* ── 06 · FAQ ───────────────────────────────────────────────────────── */
  /* Native details/summary — the accordion needs no JS. */
  .p-faq { margin-top: var(--space-6); }
  .p-faq__q {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-5);
    list-style: none;
    cursor: pointer;
    border-top: 1px solid var(--txh-rule);
    padding: var(--space-4) 0;
